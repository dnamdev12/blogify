<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title><%= blog.title %></title>
  </head>
  <body>
    <%- include('./partials/script') %> <%- include('./partials/nav') %>
    <div class="container mt-4 mb-5" style="max-width: 800px">
      <h1 class="mb-3"><%= blog.title %></h1>

      <% if (blog.createdBy) { %>
      <div class="d-flex align-items-center mb-4">
        <img
          src="<%= blog.createdBy.profileImageURL %>"
          alt="<%= blog.createdBy.fullName %>"
          class="rounded-circle me-2"
          width="40"
          height="40"
          style="object-fit: cover"
        />
        <div>
          <div class="fw-semibold"><%= blog.createdBy.fullName %></div>
          <small class="text-muted">
            <%= blog.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </small>
        </div>
      </div>
      <% } %>

      <img
        src="<%= blog.coverImageURL || '/images/default.png' %>"
        alt="<%= blog.title %>"
        class="img-fluid rounded mb-4 w-100"
        style="max-height: 450px; object-fit: cover"
      />

      <div style="white-space: pre-wrap; line-height: 1.7"><%= blog.body %></div>

      <hr class="my-5" />

      <h4 class="mb-3">Comments (<%= comments.length %>)</h4>

      <% if (locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
        <div class="mb-2">
          <textarea
            class="form-control"
            name="content"
            rows="3"
            placeholder="Write a comment..."
            required
          ></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Add Comment</button>
      </form>
      <% } else { %>
      <p class="text-muted">
        <a href="/user/signin">Sign in</a> to add a comment.
      </p>
      <% } %>

      <% comments.forEach(comment => { %>
      <div class="d-flex mb-3">
        <img
          src="<%= comment.createdBy ? comment.createdBy.profileImageURL : '/images/default.png' %>"
          alt=""
          class="rounded-circle me-2"
          width="32"
          height="32"
          style="object-fit: cover"
        />
        <div>
          <div>
            <span class="fw-semibold"><%= comment.createdBy ? comment.createdBy.fullName : 'Unknown' %></span>
            <small class="text-muted ms-2">
              <%= comment.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </small>
          </div>
          <div style="white-space: pre-wrap"><%= comment.content %></div>
        </div>
      </div>
      <% }) %>
    </div>
  </body>
</html>
